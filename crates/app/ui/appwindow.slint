import { Button, VerticalBox, HorizontalBox, ScrollView, Slider, LineEdit } from "std-widgets.slint";

export struct VideoCardData {
    id: string,
    title: string,
    channel: string,
    duration: string,
    views: string,
    thumbnail_url: string,
}

export struct ChannelCardData {
    id: string,
    title: string,
    avatar_url: string,
}

export struct PlaylistCardData {
    id: string,
    title: string,
    video_count: int,
}

component VideoCard inherits Rectangle {
    in property <VideoCardData> data;
    callback clicked();
    callback watch_later_clicked();

    background: #15161c;
    border-radius: 8px;
    border-width: 1px;
    border-color: #21222c;

    TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        Rectangle {
            height: 140px;
            background: #1b1c26;
            border-radius: 6px;
            clip: true;

            Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: dur_txt.preferred-width + 8px;
                height: 18px;
                background: #000000cc;
                border-radius: 4px;

                dur_txt := Text {
                    text: root.data.duration;
                    color: #ffffff;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        Text {
            text: root.data.title;
            color: #f0f0f5;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            max-height: 36px;
        }

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.data.channel;
                color: #a0a0b2;
                font-size: 11px;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.data.views;
                color: #7b7b90;
                font-size: 11px;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "RustTube";
    preferred-width: 1380px;
    preferred-height: 860px;
    background: #0e0f14;

    in-out property <string> current_page: "home";
    in-out property <string> search_query: "";
    in-out property <string> current_video_id: "";
    in-out property <string> current_video_title: "";
    in-out property <string> current_video_channel: "";
    in-out property <string> current_video_views: "";
    in-out property <string> current_video_published: "";
    in-out property <string> current_video_description: "";
    in-out property <string> current_quality: "1080p";
    in-out property <float> current_speed: 1.0;
    in-out property <int> volume_val: 80;
    in-out property <bool> is_playing: false;
    in-out property <bool> is_loading: false;
    in-out property <float> playback_position: 0.0;
    in-out property <float> playback_duration: 100.0;
    in-out property <string> time_display: "0:00 / 0:00";
    in-out property <string> user_display_name: "Sign In";
    in-out property <bool> is_logged_in: false;
    in-out property <string> status_message: "";
    in-out property <[VideoCardData]> video_list: [];
    in-out property <[ChannelCardData]> channel_list: [];
    in-out property <[PlaylistCardData]> playlist_list: [];

    callback navigate(string);
    callback search_submitted(string);
    callback video_selected(string, string, string);
    callback toggle_play_pause();
    callback seek_requested(float);
    callback volume_changed(int);
    callback speed_changed(float);
    callback quality_changed(string);
    callback toggle_fullscreen();
    callback toggle_subtitles();
    callback toggle_like(string);
    callback toggle_watch_later(string, string, string, string);
    callback login_google();
    callback logout_google();
    callback clear_history();
    callback clear_cache();

    HorizontalLayout {
        // Navigation Sidebar
        Rectangle {
            width: 210px;
            background: #121319;
            border-color: #1e2029;
            border-width: 1px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                // Application Brand
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 28px;
                        height: 20px;
                        background: #ff0033;
                        border-radius: 4px;
                        Text {
                            text: "▶";
                            color: #ffffff;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "RustTube";
                        color: #ffffff;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 16px; }

                Button {
                    text: "Home";
                    clicked => { root.navigate("home"); }
                }
                Button {
                    text: "Subscriptions";
                    clicked => { root.navigate("subscriptions"); }
                }
                Button {
                    text: "Playlists";
                    clicked => { root.navigate("playlists"); }
                }
                Button {
                    text: "Watch Later";
                    clicked => { root.navigate("watch_later"); }
                }
                Button {
                    text: "History";
                    clicked => { root.navigate("history"); }
                }

                Rectangle { vertical-stretch: 1; }

                Button {
                    text: "Settings";
                    clicked => { root.navigate("settings"); }
                }
            }
        }

        // Main Workspace
        VerticalLayout {
            // Search Header
            Rectangle {
                height: 56px;
                background: #101116;
                border-color: #1e2029;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 14px;

                    search_input := LineEdit {
                        placeholder-text: "Search YouTube or paste URL (Press Enter)...";
                        horizontal-stretch: 1;
                        accepted => {
                            root.search_submitted(self.text);
                        }
                    }

                    Button {
                        text: "Search";
                        clicked => {
                            root.search_submitted(search_input.text);
                        }
                    }

                    Rectangle { width: 8px; }

                    Button {
                        text: root.is_logged_in ? root.user_display_name : "Sign In";
                        clicked => {
                            if (root.is_logged_in) {
                                root.navigate("settings");
                            } else {
                                root.login_google();
                            }
                        }
                    }
                }
            }

            // Body Area
            Rectangle {
                vertical-stretch: 1;
                background: #0a0b0e;

                // Loading State
                if root.is_loading: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "Loading videos from YouTube...";
                        color: #8c90a4;
                        font-size: 14px;
                        horizontal-alignment: center;
                    }
                }

                // Dedicated Watch Page
                if root.current_page == "watch": ScrollView {
                    viewport-width: parent.width;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        // Top Navigation row
                        HorizontalLayout {
                            spacing: 12px;
                            Button {
                                text: "← Back to Browse";
                                clicked => { root.navigate("home"); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // Native Video Rendering Area
                        Rectangle {
                            height: 480px;
                            background: #000000;
                            border-radius: 8px;
                            border-color: #212330;
                            border-width: 1px;
                            clip: true;

                            // Video surface placeholder overlay
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                if !root.is_playing: Text {
                                    text: "▶ Press Play to start video";
                                    color: #5d6174;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Integrated Controls under the video
                        Rectangle {
                            height: 80px;
                            background: #13141b;
                            border-color: #20222d;
                            border-width: 1px;
                            border-radius: 8px;

                            VerticalLayout {
                                padding: 10px;
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 6px;

                                // Scrubber Slider
                                HorizontalLayout {
                                    spacing: 10px;
                                    Slider {
                                        minimum: 0.0;
                                        maximum: root.playback_duration;
                                        value: root.playback_position;
                                        changed(val) => {
                                            root.seek_requested(val);
                                        }
                                    }
                                    Text {
                                        text: root.time_display;
                                        color: #8c90a4;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                // Interactive Buttons
                                HorizontalLayout {
                                    spacing: 10px;

                                    Button {
                                        text: root.is_playing ? "Pause" : "Play";
                                        clicked => { root.toggle_play_pause(); }
                                    }

                                    Button {
                                        text: "-10s";
                                        clicked => { root.seek_requested(root.playback_position - 10.0); }
                                    }

                                    Button {
                                        text: "+10s";
                                        clicked => { root.seek_requested(root.playback_position + 10.0); }
                                    }

                                    Rectangle { width: 10px; }

                                    Text {
                                        text: "Vol:";
                                        font-size: 11px;
                                        color: #8c90a4;
                                        vertical-alignment: center;
                                    }

                                    Slider {
                                        width: 100px;
                                        minimum: 0.0;
                                        maximum: 100.0;
                                        value: root.volume_val;
                                        changed(val) => {
                                            root.volume_changed(floor(val));
                                        }
                                    }

                                    Text {
                                        text: root.volume_val + "%";
                                        font-size: 11px;
                                        color: #8c90a4;
                                        vertical-alignment: center;
                                        width: 32px;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    // Speed buttons
                                    Button {
                                        text: "0.5x";
                                        clicked => { root.speed_changed(0.5); }
                                    }
                                    Button {
                                        text: "1.0x";
                                        clicked => { root.speed_changed(1.0); }
                                    }
                                    Button {
                                        text: "1.5x";
                                        clicked => { root.speed_changed(1.5); }
                                    }
                                    Button {
                                        text: "2.0x";
                                        clicked => { root.speed_changed(2.0); }
                                    }

                                    Rectangle { width: 6px; }

                                    // Quality cycle button
                                    Button {
                                        text: root.current_quality;
                                        clicked => {
                                            if (root.current_quality == "1080p") {
                                                root.quality_changed("720p");
                                            } else if (root.current_quality == "720p") {
                                                root.quality_changed("480p");
                                            } else if (root.current_quality == "480p") {
                                                root.quality_changed("Auto");
                                            } else {
                                                root.quality_changed("1080p");
                                            }
                                        }
                                    }

                                    Button {
                                        text: "Fullscreen";
                                        clicked => { root.toggle_fullscreen(); }
                                    }
                                }
                            }
                        }

                        // Video Title and Channel Information
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.current_video_title;
                                color: #ffffff;
                                font-size: 18px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.current_video_channel;
                                    color: #a0a4b8;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.current_video_views;
                                    color: #787d92;
                                    font-size: 12px;
                                }
                                Rectangle { horizontal-stretch: 1; }

                                Button {
                                    text: "Save to Watch Later";
                                    clicked => { root.toggle_watch_later(root.current_video_id, root.current_video_title, root.current_video_channel, ""); }
                                }
                            }
                        }

                        // Video Description Box
                        if root.current_video_description != "": Rectangle {
                            background: #13141b;
                            border-color: #20222d;
                            border-width: 1px;
                            border-radius: 8px;
                            padding: 14px;

                            Text {
                                text: root.current_video_description;
                                color: #c4c8d8;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Empty State
                if !root.is_loading && root.current_page != "settings" && root.current_page != "watch" && root.video_list.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: "No videos to display.";
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Use the search bar above or check your connection.";
                        color: #7b8094;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                // Video Grid ScrollView (Home / History / Watch Later)
                if !root.is_loading && root.current_page != "settings" && root.current_page != "watch" && root.video_list.length > 0: ScrollView {
                    viewport-width: parent.width;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        if root.status_message != "": Rectangle {
                            height: 36px;
                            background: #1b1e2c;
                            border-radius: 6px;
                            border-color: #2e344e;
                            border-width: 1px;
                            Text {
                                text: root.status_message;
                                color: #8ab4f8;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        GridLayout {
                            spacing: 16px;
                            for video[i] in root.video_list: VideoCard {
                                col: mod(i, 3);
                                row: floor(i / 3);
                                width: 340px;
                                height: 220px;
                                data: video;
                                clicked => {
                                    root.current_video_id = video.id;
                                    root.current_video_title = video.title;
                                    root.current_video_channel = video.channel;
                                    root.current_video_views = video.views;
                                    root.video_selected(video.id, video.title, video.channel);
                                }
                                watch_later_clicked => {
                                    root.toggle_watch_later(video.id, video.title, video.channel, video.thumbnail_url);
                                }
                            }
                        }
                    }
                }

                // Settings View
                if root.current_page == "settings": VerticalLayout {
                    padding: 32px;
                    spacing: 20px;

                    Text {
                        text: "Settings";
                        color: #ffffff;
                        font-size: 22px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 1px;
                        background: #20222d;
                    }

                    Text {
                        text: "Google Account";
                        color: #ffffff;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: root.is_logged_in ? "Sign Out" : "Sign In with Google";
                            clicked => {
                                if (root.is_logged_in) {
                                    root.logout_google();
                                } else {
                                    root.login_google();
                                }
                            }
                        }
                        Text {
                            text: root.is_logged_in ? "Signed in as " + root.user_display_name : "Not signed in";
                            color: #a0a4b8;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { height: 8px; }

                    Text {
                        text: "Local Storage";
                        color: #ffffff;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: "Clear Watch History";
                            clicked => { root.clear_history(); }
                        }
                        Button {
                            text: "Clear Thumbnail Cache";
                            clicked => { root.clear_cache(); }
                        }
                    }
                }
            }

            // Bottom Mini Player Bar (shown only when browsing other pages while a video is loaded)
            if root.current_page != "watch" && root.current_video_id != "": Rectangle {
                height: 64px;
                background: #111218;
                border-color: #1e2029;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;

                    Button {
                        text: root.is_playing ? "Pause" : "Play";
                        clicked => { root.toggle_play_pause(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.current_video_title;
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.current_video_channel + " • " + root.time_display;
                            color: #8c90a4;
                            font-size: 11px;
                        }
                    }

                    Button {
                        text: "Open Player →";
                        clicked => { root.navigate("watch"); }
                    }
                }
            }
        }
    }
}
